default_platform(:android)

# Shared store listing: fastlane/metadata/android is also read by F-Droid and the website.
platform :android do
  desc "Check the store listing and changelog against Google Play without publishing (validate_only)"
  lane :validate_aso do
    upload_to_play_store(
      track: "internal",
      validate_only: true,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: false
    )
  end

  desc "Upload the store listing text, icon, feature graphic, screenshots and changelogs, without a build"
  lane :push_aso do
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true
    )
  end

  desc "Build a signed release AAB and upload it as a draft to a testing track, e.g. fastlane beta_release version:0.44.0 [track:alpha|internal]"
  lane :beta_release do |options|
    version = options[:version] || UI.user_error!("Pass version:X.Y.Z (becomes versionName and versionCode, which must grow with every upload)")
    UI.user_error!("keystore.properties is missing, so the bundle would be signed with the debug key and Play would reject it") unless File.exist?(File.expand_path("../keystore.properties", __dir__))
    gradle(task: "bundleRelease", properties: { "appVersion" => version }, project_dir: "..")
    upload_to_play_store(
      track: options[:track] || "alpha", # Play's "alpha" track is closed testing
      aab: File.expand_path("../app/build/outputs/bundle/release/app-release.aab", __dir__),
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
