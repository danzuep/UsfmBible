<?xml version="1.0" encoding="utf-8"?>
<!-- Modified by Daniel Collingwood, 2026 -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/chapter_selection_old_testament"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/background_chapter_selection"
                android:gravity="center"
                android:padding="@dimen/padding"
                android:text="@string/text_chapter_selection_old_testament"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_primary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/chapter_selection_new_testament"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/background_chapter_selection"
                android:gravity="center"
                android:padding="@dimen/padding"
                android:text="@string/text_chapter_selection_new_testament"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_primary" />
        </LinearLayout>

        <io.github.danzuep.usfmbible.reading.chapter.ChapterListView
            android:id="@+id/chapter_list_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/verse_selection_book"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_chapter_selection"
            android:gravity="center"
            android:padding="@dimen/padding"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_primary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/verse_selection_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/black"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:visibility="gone">

            <GridView
                android:id="@+id/verse_selection_verses"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:columnWidth="@dimen/chapter_grid_width"
                android:numColumns="auto_fit"
                android:stretchMode="columnWidth" />
        </LinearLayout>
    </LinearLayout>
</merge>
